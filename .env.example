# Copy to .env and fill in your values. Never commit .env.
#
# These are the same variable names the Cognite Toolkit generates, so if you
# already have a working toolkit .env you can copy it here unchanged.

CDF_CLUSTER=my-cluster
CDF_PROJECT=my-project
PROVIDER=entra_id
LOGIN_FLOW=client_credentials

# Service principal used by the toolkit, the extractor and the notebooks
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_TENANT_ID=

# Derived from the values above - adjust if your cluster URL differs
CDF_URL=https://my-cluster.cognitedata.com
IDP_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
IDP_AUDIENCE=https://my-cluster.cognitedata.com
IDP_SCOPES=https://my-cluster.cognitedata.com/.default
